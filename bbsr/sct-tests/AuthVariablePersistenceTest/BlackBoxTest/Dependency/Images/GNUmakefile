#/*++
#
# Module Name:
#
#   makefile
#
# Abstract:
#
#   This is the makefile for for generating authenticated variable test data.
#
#--*/

OPENSSL ?= openssl
SIGN_EFI_SIG_LIST ?= sign-efi-sig-list

ifeq ($(strip $(WORKSPACE)),)
TEST_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
else
TEST_DIR := $(WORKSPACE)/SctPkg/TestCase/UEFI/EFI/RuntimeServices/AuthVariablePersistenceTest/BlackBoxTest
endif
BASE_NAME := SecureBoot
TARGET := $(TEST_DIR)/$(BASE_NAME)

AUTH_VAR_GUID := 6f5345c5-4f42-4e8e-9a5c-87bf48a6d72c
AUTH_VAR_NAME := SecureBootAuthPersistenceVar

KEY := $(TARGET)_AuthVarTest.key
CERT := $(TARGET)_AuthVarTest.crt
PAYLOAD := $(TARGET)_AuthVarPayload.bin
CREATE_AUTH := $(TARGET)_AuthVarCreate.auth
DELETE_AUTH := $(TARGET)_AuthVarDelete.auth
AUTH_DATA := $(TEST_DIR)/SecureBootAuthVariablePersistenceAuthData.inc

CREATE_TIME := $(shell date -u '+%Y-%m-%d %H:%M:%S')
DELETE_TIME := $(shell date -u -d '$(CREATE_TIME) UTC + 1 minute' '+%Y-%m-%d %H:%M:%S')

.PHONY: all clean

all: $(AUTH_DATA)

$(CERT):
	$(OPENSSL) req -new -x509 -newkey rsa:2048 -sha256 -nodes \
	  -subj /CN=ACS_SecureBoot_AuthVar_Test/ -days 36500 \
	  -keyout $(KEY) -out $(CERT)

$(KEY): $(CERT)

$(PAYLOAD):
	printf '%s' 'Secure Boot authenticated variable persistence test' > $@

$(CREATE_AUTH): $(CERT) $(KEY) $(PAYLOAD)
	$(SIGN_EFI_SIG_LIST) -g $(AUTH_VAR_GUID) -t '$(CREATE_TIME)' \
	  -c $(CERT) -k $(KEY) $(AUTH_VAR_NAME) $(PAYLOAD) $@

$(DELETE_AUTH): $(CERT) $(KEY)
	$(SIGN_EFI_SIG_LIST) -g $(AUTH_VAR_GUID) -t '$(DELETE_TIME)' \
	  -c $(CERT) -k $(KEY) $(AUTH_VAR_NAME) /dev/null $@

$(AUTH_DATA): $(CREATE_AUTH) $(DELETE_AUTH)
	@{ \
	  echo '/* Auto-generated by Dependency/Images/GNUmakefile. */'; \
	  echo 'CONST UINT8 gSecureBootAuthVariableCreateData[] = {'; \
	  od -An -v -t x1 $(CREATE_AUTH) | sed -e 's/^ */  /' -e 's/\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	  echo '};'; \
	  echo 'CONST UINT8 gSecureBootAuthVariableDeleteData[] = {'; \
	  od -An -v -t x1 $(DELETE_AUTH) | sed -e 's/^ */  /' -e 's/\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	  echo '};'; \
	} > $@

clean:
	$(RM) $(KEY) $(CERT) $(PAYLOAD) $(CREATE_AUTH) $(DELETE_AUTH) $(AUTH_DATA)
